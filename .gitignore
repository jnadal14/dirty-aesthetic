# Full-resolution masters. These are the inputs to scripts/optimize_images.py
# and are never served, so they stay out of the repository entirely.
#
# Committing them is what grew this repo past 990 MB and eventually broke the
# GitHub Pages build, which has to clone the whole history to publish.
#
# _source/ is NOT backed up by git. Keep it backed up somewhere else.
_source/

# Everything the site actually serves lives in assets/ and is committed.

# macOS / Python noise
.DS_Store
**/.DS_Store
__pycache__/
*.pyc

# Local editor/assistant notes
CLAUDE.md
AGENTS.md

# Local test harness (Playwright, Lighthouse). Never deployed.
tools/

# Next.js build output and dependencies
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
